{
  "name": "dokimana",
  "version": "0.1.0",
  "description": "Local CLI that traces Stripe OpenAPI changes to call sites",
  "keywords": [
    "cli",
    "typescript",
    "javascript",
    "stripe",
    "openapi",
    "api-compatibility",
    "static-analysis",
    "developer-tools",
    "github-action"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dokimana": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D1bakar/Dokimana.git"
  },
  "homepage": "https://github.com/D1bakar/Dokimana#readme",
  "bugs": {
    "url": "https://github.com/D1bakar/Dokimana/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/src/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx scripts/benchmark.ts",
    "bench": "tsx scripts/accuracy-bench.ts",
    "lint": "eslint . --max-warnings=0",
    "docs:rules": "tsx scripts/generate-rules.ts",
    "format": "prettier --write \"**/*.{ts,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,yml,yaml,md}\""
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
